# Copy this file to .env and fill in the keys you have.
# Leave a key empty if you don't use that provider: it is then skipped.
OPENAI_API_KEY=       # OpenAI Platform
ANTHROPIC_API_KEY=    # Anthropic Console
GOOGLE_API_KEY=       # Google AI Studio (Gemini)
MISTRAL_API_KEY=      # Mistral La Plateforme

# Routing mode: all (default), openai, anthropic, gemini, sovereign (Mistral only)
# AUTOROUTE_MODE=all
