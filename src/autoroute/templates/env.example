# Copy this file to .env and fill in the keys you have.
# Leave a key empty if you don't use that provider: it is then skipped.
OPENAI_API_KEY=       # https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=    # https://platform.claude.com (Claude Console)
GOOGLE_API_KEY=       # https://aistudio.google.com (Gemini)
MISTRAL_API_KEY=      # https://console.mistral.ai (Mistral AI Studio)

# Routing mode: all (default), openai, anthropic, gemini, sovereign (Mistral only)
# AUTOROUTE_MODE=all
